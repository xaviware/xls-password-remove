;Password Eliminator .XLS
;General Information
[GralInfo]
TranslatorName="Kaloyan Stolinov"
TranslatorURL="http://bul-source.com"
TranslatorEMail="kaloyan.stolinov@bul-source.com"
TranslatorDate="April 2007"
LanguageName="Bulgarian"
LanguageFileVersion="v.1.0"
;SPECIAL TAGS:
;<APP/>   = Aplication Name (Password Eliminator.XLS)
;<FILE/>  = Excel File Name
;<BOOK/>  = Excel WorkBook Name
;<SHEET/> = Excel Sheet Name

;ToolBar Area
[cmdOpen]
ToolTipText="Отвори .XLS файл"
